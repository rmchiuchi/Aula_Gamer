<!--This Document is generated by GameMaker, if you edit it by hand then you do so at your own risk!-->
<object>
  <spriteName>spritePersonagem</spriteName>
  <solid>-1</solid>
  <visible>-1</visible>
  <depth>0</depth>
  <persistent>0</persistent>
  <parentName>&lt;undefined&gt;</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>
// CREATE

// Velocidades horizontais e inércia
hspd = 0;             // Velocidade horizontal atual
spd_andar = 7;        // Velocidade máxima andando
spd_correr = 10;       // Velocidade máxima correndo
acel = 0.2;           // O quão rápido ele ganha velocidade
atrito = 0.25;        // O quão rápido ele desliza até parar

// Velocidades verticais e gravidade
vspd = 0;             // Velocidade vertical atual
grav = 0.5;           // Força da gravidade constante
jspd = -9;            // Força do pulo normal andando
jspd_correndo = -11;  // Força do pulo mais alto correndo (Estilo Mario)

// Tocar a música de fundo em loop
audio_play_sound(soundTemaInicial, 1, true);

</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>// 1. Ler os comandos do teclado (WASD / Espaço / Shift)
var key_right     = keyboard_check(ord('D'));
var key_left      = keyboard_check(ord('A'));
var key_jump      = keyboard_check_pressed(vk_space); 
var key_jump_held = keyboard_check(vk_space);   
var key_run       = keyboard_check(vk_shift); // LER O SHIFT PARA CORRER

// Define a velocidade máxima com os valores que você criou no Create Event
var max_spd = spd_andar;
if (key_run) {
    max_spd = spd_correr;
}
// --------------

// 2. Aceleração e Atrito Horizontal (Estilo Mario)
var move = key_right - key_left;

if (move != 0) {
    // Acelera gradativamente na direção desejada
    hspd += move * acel;
    // Limita a velocidade máxima atual usando o max_spd corrigido
    hspd = clamp(hspd, -max_spd, max_spd);
    
    // --- CÓDIGO PARA VIRAR O ROSTO ---
    image_xscale = move;
} else {
    // Aplica o atrito (desliza um pouco antes de parar)
    if (hspd &gt; 0) hspd = max(0, hspd - atrito);
    if (hspd &lt; 0) hspd = min(0, hspd + atrito);
}

// 3. Aplicar Gravidade
vspd += grav;

// 4. Verificar se está no chão para poder pular
var no_chao = place_meeting(x, y + 1, obj_parede);

if (no_chao) {
    vspd = 0; 
    if (key_jump) {
        // Se estiver correndo rápido, o pulo é mais alto (Igual ao Mario)
        if (abs(hspd) &gt;= spd_correr - 1) {
            vspd = jspd_correndo; 
        } else {
            vspd = jspd; 
        }
    }
}
// 5. Pulo controlado pela altura
if (vspd &lt; 0 &amp;&amp; !key_jump_held) {
    vspd = max(vspd, jspd / 3); 
}

// 6. Sistema de Colisão Horizontal com a Parede
if (place_meeting(x + hspd, y, obj_parede)) {
    while (!place_meeting(x + sign(hspd), y, obj_parede)) {
        x += sign(hspd);
    }
    hspd = 0;
}
x += hspd;
// 7. Sistema de Colisão Vertical com a Parede
if (place_meeting(x, y + vspd, obj_parede)) {
    while (!place_meeting(x, y + sign(vspd), obj_parede)) {
        y += sign(vspd);
    }
    vspd = 0;
}
y += vspd;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="4" ename="objectInimigo">
      <action>
        <libid>1</libid>
        <id>603</id>
